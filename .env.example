# Copy to `.env` in the project root (never commit real secrets).

# Plaid — https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# Optional: stable id for this single-user install
PLAID_CLIENT_USER_ID=personal-user

# Optional: public URL for webhooks (e.g. ngrok) → POST /api/plaid/webhook
# PLAID_WEBHOOK_URL=https://your-tunnel.example/api/plaid/webhook

SERVER_PORT=3847

# Optional: override API URL baked into the frontend bundle (default http://127.0.0.1:3847)
# API_BASE=http://127.0.0.1:3847
